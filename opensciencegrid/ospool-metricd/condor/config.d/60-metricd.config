
# should have a default, but it is missing
METRICD = /usr/libexec/condor/condor_metricd

use FEATURE: METRICD

METRICD_BACKENDS = prometheus

# don't worry about individual glideins, only do aggregate
METRICD_PER_EXECUTE_NODE_METRICS = False

# Define the port and directory path for metrics collection
PROMETHEUS_HTTP_PORT = 9100

# allow connections from outside localhost
PROMETHEUS_HTTP_LOCALHOST_ONLY = False

